# Copy to .env and fill in only what you want. Never commit .env.
# All integrations are optional; without keys those checks are simply skipped.

# Reputation sources (optional)
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# Approximate IP geolocation via ipinfo.io (works without a token at low volume)
IPINFO_TOKEN=
NARDTRACE_GEO_ENABLED=true

# Set to 1 to disable ALL external lookups (DNS, RDAP, geolocation, reputation).
NARDTRACE_OFFLINE=0

# Storage (inside the container this is the /data volume)
# NARDTRACE_DATA_DIR=./data
# NARDTRACE_MAX_UPLOAD_MB=25
# NARDTRACE_DNS_TIMEOUT=5
# NARDTRACE_HTTP_TIMEOUT=10
